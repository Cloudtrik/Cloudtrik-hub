# Enforce node engine version against the constraint declared in package.json.
# pnpm reads .npmrc; this ensures contributors and CI use the supported node major.
engine-strict=true
# Publish auth: CI uses the GitHub Actions Trusted Publisher OIDC flow declared in
# .github/workflows/release.yml. Local `npm publish` works only if a per-user token
# is present; CI uses provenance + OIDC short-lived credentials with no token storage.
